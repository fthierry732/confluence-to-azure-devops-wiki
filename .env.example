# Confluence Configuration
# Your Confluence instance URL (e.g., https://yourcompany.atlassian.net)
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net

# Your Confluence username (usually your email address)
CONFLUENCE_USERNAME=your.email@company.com

# Your Confluence API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# The Confluence space key you want to migrate (e.g., EVP, DOCS, etc.)
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY

# Azure DevOps Configuration
# Your Azure DevOps organization name
DEVOPS_ORGANIZATION=your-organization

# Your Azure DevOps project name
DEVOPS_PROJECT=your-project

# Your Azure DevOps wiki identifier (usually project-name.wiki)
DEVOPS_WIKI_IDENTIFIER=your-project.wiki

# Your Azure DevOps Personal Access Token (PAT)
# Generate from: https://dev.azure.com/{organization}/_usersSettings/tokens
DEVOPS_PAT=your_azure_devops_pat_here
